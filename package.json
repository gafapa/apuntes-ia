{
  "name": "apuntes-ia",
  "productName": "Apuntes IA",
  "version": "0.2.0",
  "description": "Crea apuntes con varios agentes de IA (Claude Code y Codex) trabajando en paralelo",
  "author": "Pablo Gallego",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "dev:electron": "npm run build && electron .",
    "build:web": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:web && npm run build:main",
    "typecheck": "tsc --noEmit",
    "fetch-bin": "node scripts/fetch-bin.mjs",
    "dist": "npm run build && npm run fetch-bin && electron-builder",
    "start": "npm run build && electron .",
    "dist:publicar": "npm run build && npm run fetch-bin && electron-builder --publish always",
    "app": "node scripts/app-en-vivo.mjs",
    "catalogo:fp": "node scripts/catalogo-fp.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "abcjs": "^6.7.1",
    "algebrite": "^1.4.0",
    "d3-composite-projections": "^2.0.0",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "es-atlas": "^0.6.0",
    "fastify": "^5.12.5",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.2",
    "markdown-it-container": "^4.0.0",
    "mhchemparser": "^4.2.1",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "smiles-drawer": "^2.4.1",
    "topojson-client": "^3.1.0",
    "tree-kill": "^1.2.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.6.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TU_USUARIO/apuntes-ia.git"
  }
}
